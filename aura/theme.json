{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Aura",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true,
			"palette": [
				{
					"name": "Base",
					"slug": "base",
					"color": "#FFFFFF"
				},
				{
					"name": "Surface",
					"slug": "surface",
					"color": "#F8FAFC"
				},
				{
					"name": "Surface Strong",
					"slug": "surface-strong",
					"color": "#F1F5F9"
				},
				{
					"name": "Contrast",
					"slug": "contrast",
					"color": "#0F172A"
				},
				{
					"name": "Muted",
					"slug": "muted",
					"color": "#64748B"
				},
				{
					"name": "Border",
					"slug": "border",
					"color": "#E2E8F0"
				},
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#4338CA"
				},
				{
					"name": "Primary Dark",
					"slug": "primary-dark",
					"color": "#3730A3"
				},
				{
					"name": "Primary Soft",
					"slug": "primary-soft",
					"color": "#EEF2FF"
				},
				{
					"name": "Primary Contrast",
					"slug": "primary-contrast",
					"color": "#FFFFFF"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#F59E0B"
				},
				{
					"name": "Success",
					"slug": "success",
					"color": "#15803D"
				},
				{
					"name": "Danger",
					"slug": "danger",
					"color": "#B91C1C"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fluid": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"fontFamilies": [
				{
					"fontFamily": "Vazirmatn, Vazir, Tahoma, 'Segoe UI', system-ui, -apple-system, sans-serif",
					"name": "Vazirmatn",
					"slug": "vazirmatn"
				},
				{
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, Tahoma, sans-serif",
					"name": "System UI",
					"slug": "system"
				}
			],
			"fontSizes": [
				{
					"name": "X-Small",
					"size": "0.75rem",
					"slug": "x-small"
				},
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.25rem",
					"slug": "large",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"name": "X-Large",
					"size": "1.5rem",
					"slug": "x-large",
					"fluid": {
						"min": "1.375rem",
						"max": "1.875rem"
					}
				},
				{
					"name": "XX-Large",
					"size": "2rem",
					"slug": "xx-large",
					"fluid": {
						"min": "1.75rem",
						"max": "2.75rem"
					}
				},
				{
					"name": "Huge",
					"size": "3.5rem",
					"slug": "huge",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"customSpacingSize": true,
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"name": "2XS",
					"size": "0.5rem",
					"slug": "10"
				},
				{
					"name": "XS",
					"size": "0.75rem",
					"slug": "20"
				},
				{
					"name": "S",
					"size": "1rem",
					"slug": "30"
				},
				{
					"name": "M",
					"size": "1.5rem",
					"slug": "40"
				},
				{
					"name": "L",
					"size": "2rem",
					"slug": "50"
				},
				{
					"name": "XL",
					"size": "3rem",
					"slug": "60"
				},
				{
					"name": "2XL",
					"size": "4.5rem",
					"slug": "70"
				},
				{
					"name": "3XL",
					"size": "6rem",
					"slug": "80"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft",
					"slug": "soft",
					"shadow": "0 1px 2px rgba(15, 23, 42, 0.06), 0 4px 16px rgba(15, 23, 42, 0.06)"
				},
				{
					"name": "Lift",
					"slug": "lift",
					"shadow": "0 16px 40px -16px rgba(15, 23, 42, 0.25)"
				},
				{
					"name": "Glass",
					"slug": "glass",
					"shadow": "0 8px 32px rgba(15, 23, 42, 0.08)"
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "6px",
				"md": "12px",
				"lg": "18px",
				"pill": "999px"
			},
			"base-font-size": "1rem",
			"gutter": "clamp(1rem, 4vw, 2.5rem)",
			"motion": {
				"duration": "200ms",
				"duration-slow": "600ms",
				"easing": "cubic-bezier(0.2, 0.7, 0.2, 1)",
				"distance": "12px",
				"hover-scale": "1.03"
			},
			"header": {
				"blur": "14px",
				"background": "rgba(255, 255, 255, 0.72)"
			},
			"input": {
				"height": "48px",
				"padding": "0.75rem 1rem",
				"border-color": "var(--wp--preset--color--border)",
				"focus-ring": "0 0 0 3px rgba(67, 56, 202, 0.18)"
			}
		},
		"blocks": {
			"woocommerce/product-collection": {
				"spacing": {
					"blockGap": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|vazirmatn",
			"fontSize": "var(--wp--custom--base-font-size)",
			"fontWeight": "400",
			"lineHeight": "1.7",
			"letterSpacing": "0"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"top": "0",
				"right": "var(--wp--custom--gutter)",
				"bottom": "0",
				"left": "var(--wp--custom--gutter)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary-dark"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|huge"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|primary-contrast"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)"
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-dark",
						"text": "var:preset|color|primary-contrast"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "var(--wp--custom--radius--pill)"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"right": "1.5rem",
						"bottom": "0.85rem",
						"left": "1.5rem"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				}
			},
			"core/cover": {
				"border": {
					"radius": "var(--wp--custom--radius--lg)"
				}
			},
			"core/search": {
				"border": {
					"color": "var:preset|color|border",
					"radius": "var(--wp--custom--radius--pill)"
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"woocommerce/product-collection": {
				"spacing": {
					"blockGap": "var:preset|spacing|50"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "mini-cart",
			"title": "Mini Cart",
			"area": "uncategorized"
		}
	]
}
